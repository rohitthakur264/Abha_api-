ABDM_CLIENT_ID=your-abdm-client-id
ABDM_CLIENT_SECRET=your-abdm-client-secret
ABDM_HIP_ID=your-hip-facility-id
ABDM_CM_ID=sbx

WEBHOOK_SITE_BASE=https://webhook.site
WEBHOOK_SITE_TOKEN=your-webhook-site-token

ABDM_SESSION_URL=https://dev.abdm.gov.in/api/hiecm/gateway/v3/sessions
ABDM_BRIDGE_URL_ENDPOINT=https://dev.abdm.gov.in/api/hiecm/gateway/v3/bridge/url
ABDM_GENERATE_TOKEN_URL=https://dev.abdm.gov.in/api/hiecm/v3/token/generate-token

# Milestone 1 (M1) - ABHA Enrolment & Verification Settings
ABHA_BASE_URL=https://abhasbx.abdm.gov.in
ABHA_CERT_URL=https://abhasbx.abdm.gov.in/abha/api/v3/profile/public/certificate
ABDM_PUBLIC_CERT_PEM=
RSA_PADDING_ALGORITHM=OAEP-SHA1
ABHA_CONSENT_CODE=abha-enrollment
ABHA_CONSENT_VERSION=1.4

HTTP_TIMEOUT=35
POLL_TIMEOUT=20
POLL_SECONDS=5
POLL_STEP_SECONDS=2.0
CALLBACK_WAIT_SECONDS=35
SIMULATE_WAIT_SECONDS=8
WEBHOOK_PER_PAGE=50
RATE_LIMIT_BACKOFF_SECONDS=3
TOKEN_EXPIRY_FALLBACK=600
TOKEN_REFRESH_BUFFER_SECONDS=30
LOG_PREVIEW_LENGTH=400
TOKEN_PREVIEW_LENGTH=24

ENABLE_WEBHOOK_POLLING=1
ENABLE_DEMO_ROUTES=1
# Must be 0 when Postman (not Python) sends the ABDM requests (e.g. CEO demo)
ONLY_MATCHED_CALLBACKS=0
DEBUG_BREAKPOINTS=0

