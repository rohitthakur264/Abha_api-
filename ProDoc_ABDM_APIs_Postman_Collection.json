{
  "info": {
    "name": "ProDoc ABDM APIs (Manual Testing)",
    "_postman_id": "prodoc-abdm-manual-collection",
    "description": "Manual step-by-step testing collection for ProDoc ABDM APIs (APIs 1 to 8). No background test scripts. Hit each API one by one, inspect the response, copy the returned ID, paste into the next API, and validate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Setup: Bridge & Session",
      "item": [
        {
          "name": "Inspect Global Session Token (Req 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/abdm/session/token",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "api",
                "abdm",
                "session",
                "token"
              ]
            },
            "description": "Senior Req 1: Inspects the active GLOBAL_ACCESS_TOKEN and its remaining validity. Automatically generates a fresh token if expired."
          }
        },
        {
          "name": "Open Webhook Channel (Req 3)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/abdm/webhook/open",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "api",
                "abdm",
                "webhook",
                "open"
              ]
            },
            "description": "Senior Req 3: Opens the webhook listener, registers callback URL with ABDM gateway, and attaches the callback handler."
          }
        },
        {
          "name": "Simulate Webhook Push Callback (Req 3)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"response\": {\n    \"requestId\": \"req-demo-001\"\n  },\n  \"status\": \"SUCCESS\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/abdm/webhook/callback",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "api",
                "abdm",
                "webhook",
                "callback"
              ]
            },
            "description": "Senior Req 3: Tests direct incoming push callback. Fires on_message_received() and immediately acknowledges: 'I have received this message'."
          }
        },
        {
          "name": "Register Bridge URL to ABDM",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/register-bridge",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "register-bridge"
              ]
            },
            "description": "Registers webhook URL with ABDM gateway and returns the exact 'bridge_url' in the JSON response."
          }
        },
        {
          "name": "Get Configured Bridge URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/bridge-url",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "bridge-url"
              ]
            },
            "description": "Returns current bridge webhook URL for easy copying."
          }
        }
      ]
    },
    {
      "name": "M1: ProDoc ABHA Integration (Calls 3 to 7 - ALL POST)",
      "item": [
