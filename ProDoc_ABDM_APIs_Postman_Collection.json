              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"P10025\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/abdm/patients/abha-qr",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
